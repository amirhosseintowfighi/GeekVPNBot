# Geek VPN - environment template.
# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------- application
APP__NAME=Geek VPN
APP__ENVIRONMENT=local            # local | dev | staging | production
APP__DEBUG=true
APP__BASE_URL=http://localhost:8000

# -------------------------------------------------------------------- logging
LOGGING__LEVEL=INFO
LOGGING__JSON=true

# ------------------------------------------------------------------- postgres
POSTGRES__HOST=postgres
POSTGRES__PORT=5432
POSTGRES__USER=geekvpn
POSTGRES__PASSWORD=change-me
POSTGRES__DB=geekvpn
POSTGRES__POOL_SIZE=10
POSTGRES__MAX_OVERFLOW=20

# ----------------------------------------------------------------------- redis
REDIS__HOST=redis
REDIS__PORT=6379
REDIS__DB=0
REDIS__PASSWORD=

# -------------------------------------------------------------------- telegram
TELEGRAM__BOT_TOKEN=
TELEGRAM__WEBHOOK_SECRET=
TELEGRAM__WEBHOOK_PATH=/telegram/webhook
# How long Telegram initData stays acceptable (seconds). 24h by default.
TELEGRAM__AUTH_MAX_AGE_SECONDS=86400

# ---------------------------------------------------------------------- auth
# REQUIRED in production. Minimum 32 characters.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH__JWT_SECRET_KEY=insecure-development-key-do-not-use-in-production
AUTH__JWT_ISSUER=geekvpn
AUTH__JWT_AUDIENCE=geekvpn-clients
AUTH__ACCESS_TOKEN_TTL_MINUTES=15

# Customers: long sliding window, they must not be logged out mid-purchase.
AUTH__USER_REFRESH_TTL_DAYS=30
AUTH__USER_ABSOLUTE_TTL_DAYS=180

# Admins: deliberately short.
AUTH__ADMIN_REFRESH_TTL_HOURS=12
AUTH__ADMIN_ABSOLUTE_TTL_HOURS=24

# Comma-separated. Empty means "any IP". Strongly recommended in production.
AUTH__ADMIN_IP_ALLOWLIST=

# Used once by `python -m geekvpn.entrypoints.create_admin`.
AUTH__BOOTSTRAP_ADMIN_USERNAME=admin
AUTH__BOOTSTRAP_ADMIN_PASSWORD=

# ------------------------------------------------------------------- security
SECURITY__CORS_ORIGINS=http://localhost:3000
SECURITY__ALLOWED_HOSTS=*

# ---------------------------------------------------------------------------
# Security (phase 13)
# ---------------------------------------------------------------------------
# Signing secret for access tokens and the CSRF cookie. At least 32 characters.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(36))"
SECURITY__SECRET_KEY=

# Master secret for data encrypted at rest (card numbers, payment proofs).
# MUST differ from SECURITY__SECRET_KEY: sharing one secret couples the two
# rotations permanently, so the token key could never be rotated without
# re-encrypting every stored card number. Losing this key means the encrypted
# columns are unrecoverable - keep it in a password manager, not only here.
SECURITY__ENCRYPTION_MASTER_KEY=
SECURITY__ENCRYPTION_ACTIVE_KEY_ID=k1
# Comma-separated. Keys that must still decrypt but must no longer encrypt.
SECURITY__ENCRYPTION_RETIRED_KEY_IDS=

# Number of reverse proxies in front of the application. One when running behind
# the bundled nginx. The IP allowlist reads X-Forwarded-For from the RIGHT using
# this count, so a client-supplied leftmost entry cannot impersonate an
# allowlisted address. Set it wrong and the admin allowlist is bypassable.
SECURITY__TRUSTED_PROXY_COUNT=1

# ---------------------------------------------------------------------------
# Deployment: domains and TLS (phase 14)
# ---------------------------------------------------------------------------
# The API hostname. Required. Certbot issues one certificate covering all three.
PRIMARY_DOMAIN=example.com
ADMIN_DOMAIN=admin.example.com
MINIAPP_DOMAIN=app.example.com
# Email Let's Encrypt uses for expiry warnings. Not optional in practice: it is
# the only warning you get if renewal has been silently failing.
CERTBOT_EMAIL=

# Comma-separated CIDRs allowed to reach the admin panel at the EDGE, in addition
# to the application-level allowlist. Empty means nginx allows everyone through
# and AUTH__ADMIN_IP_ALLOWLIST is the only gate.
ADMIN_ALLOW_CIDRS=

# Local HTTP port for the development compose file only.
HTTP_PORT=80

# ---------------------------------------------------------------------------
# Deployment: images and capacity (phase 14)
# ---------------------------------------------------------------------------
IMAGE_REPOSITORY=geekvpn-backend
IMAGE_TAG=latest
# Uvicorn workers per API container. Rule of thumb: (2 x cores) + 1, capped by
# POSTGRES__POOL_SIZE x workers staying under POSTGRES_MAX_CONNECTIONS.
UVICORN_WORKERS=4
API_MEMORY_LIMIT=1g
# Networks uvicorn will believe forwarding headers from. Never "*" in production:
# that tells uvicorn to trust the client's own X-Forwarded-For.
FORWARDED_ALLOW_IPS=172.16.0.0/12

# Postgres tuning. Defaults suit a 4 GB VPS.
POSTGRES_MAX_CONNECTIONS=200
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1536MB
POSTGRES_WORK_MEM=16MB
# Redis holds rate-limit counters with noeviction, so it must never fill up.
REDIS_MAXMEMORY=512mb

# ---------------------------------------------------------------------------
# Monitoring (phase 14)
# ---------------------------------------------------------------------------
# Grafana admin password. Required: the image defaults to admin/admin.
GRAFANA_ADMIN_PASSWORD=
# Private Telegram group that receives alerts. MUST NOT be a customer chat -
# alert text contains internal path names and counts.
ALERT_TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Backup (phase 14)
# ---------------------------------------------------------------------------
# Passphrase used to encrypt every dump. At least 20 characters; backup.sh
# refuses to run without it rather than write an unencrypted dump. Store it
# somewhere OTHER than this server - a backup encrypted with a key that only
# exists on the machine being backed up protects against nothing.
BACKUP_PASSPHRASE=
BACKUP_RETENTION_DAYS=14
# Optional off-site target, e.g. s3://geekvpn-backups/production. Without it the
# backups live only on this host.
BACKUP_S3_TARGET=
