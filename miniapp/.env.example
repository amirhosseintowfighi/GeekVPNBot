# Base URL of the FastAPI backend that already serves the bot.
NEXT_PUBLIC_API_BASE_URL=https://api.geekvpn.example

# Public bot username, used to build referral deep links.
NEXT_PUBLIC_BOT_USERNAME=GeekVpnBot

# Server-side only. Used to verify Telegram initData signatures.
# Never give this a NEXT_PUBLIC_ prefix - that would ship the bot token to
# every browser and let anyone mint a valid session.
TELEGRAM_BOT_TOKEN=
